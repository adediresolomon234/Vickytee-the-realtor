{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "dist/server/index.js",
	"name": "vickytee-realtor",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
